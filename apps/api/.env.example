# Local configuration for the API service. Copy to `.env` and fill in.
#
# This file describes a LOCAL DEVELOPMENT machine. Production values live in
# Railway (`.railway/railway.ts` declares which ones), and the two should never
# be the same — a local `.env` pointing at the production database and a
# production payment token means an experiment can delete a writer's novel or
# charge a real card.
#
# Values must be UNQUOTED: `node --env-file` tolerates quotes but
# `docker --env-file` treats them as part of the value, which is how a quoted
# gateway key reaches the container as `"vck_...` and the gateway answers with
# an empty stream instead of an error.

# --- Data -------------------------------------------------------------------
# The dev stack from docker-compose.yml at the repo root:
#   docker compose up -d && pnpm db:reset
DATABASE_URL=postgres://bts:bts@127.0.0.1:55432/bts?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379
# Optional; defaults to 10.
# DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# 32+ characters. Also derives the key that seals queued sign-in codes.
# Any random string will do locally: openssl rand -hex 32
AUTH_SECRET=

# --- Mail -------------------------------------------------------------------
# Sign-in codes are emailed. Without a key the worker cannot deliver them, so
# read the code out of the worker's log instead.
RESEND_API_KEY=
EMAIL_FROM=BehindTheStory <auth@behindthestory.co>

# --- AI ---------------------------------------------------------------------
# Every model call goes through the Vercel AI Gateway. Real spend, even locally.
AI_GATEWAY_API_KEY=
# Optional overrides. Which model writes prose is normally a per-workspace
# choice resolved against the catalogue in packages/ai/src/models.ts; these
# only change the fallbacks.
# AI_MODEL=google/gemini-3.7-flash
# AI_UTILITY_MODEL=google/gemini-3.7-flash
# AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Hard cap on prompt size, in tokens. Every fixed word price assumes it.
# AI_CONTEXT_BUDGET=40000

# --- Billing ----------------------------------------------------------------
# Where checkout sends the writer back to.
APP_URL=http://localhost:3000

# `sandbox` or `production`. NOT OPTIONAL IN PRACTICE: leaving it unset falls
# back to sandbox, and a production token against the sandbox host answers 401
# with nothing in the message to suggest why.
#
# Keep this on `sandbox` locally. Sandbox is a separate Polar organisation with
# its own token and its own product ids, so this line and every id below move
# together — production values belong in Railway, not here.
POLAR_SERVER=sandbox

# Organization Access Token from Settings → Developers.
# Scopes: checkouts:write, customers:read, customer_sessions:write
POLAR_ACCESS_TOKEN=

# From Settings → Webhooks when you create the endpoint.
#
# Point that endpoint at the API's own hostname, never at the studio: Polar
# does not follow redirects, and the studio's rewrite is a 3xx, which counts as
# a failed delivery. Ten consecutive failures disable the endpoint.
#   local:      polar listen http://localhost:3001/api/billing/webhook
#   production: https://api.behindthestory.co/api/billing/webhook
#
# Optional locally: returning from checkout syncs the plan directly, so the
# happy path works without a tunnel. Cancellations and renewals do not.
POLAR_WEBHOOK_SECRET=

# Product ids. Plain fixed prices — no meters, no benefits; the word balance is
# enforced in this database, not in Polar.
#   starter  $6/month    pro  $14/month    team  $39/month
POLAR_PRODUCT_STARTER_MONTHLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_TEAM_MONTHLY=
#   one-off packs: 30k $5, 100k $14, 300k $36
POLAR_PRODUCT_WORDS_30K=
POLAR_PRODUCT_WORDS_100K=
POLAR_PRODUCT_WORDS_300K=

# --- Runtime ----------------------------------------------------------------
PORT=3001
# Only needed if migrations are not where the package puts them.
# DB_MIGRATIONS_DIR=../../packages/db/migrations
