{
  "name": "@behindthestory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./type": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file=.env dist/index.js",
    "check:balance": "tsx scripts/check-word-balance.mts",
    "check:metering": "tsx scripts/check-metering.mts",
    "check:webhook": "tsx scripts/check-billing-webhook.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@behindthestory/ai": "workspace:*",
    "@behindthestory/core": "workspace:*",
    "@behindthestory/db": "workspace:*",
    "@behindthestory/jobs": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.7.4",
    "ai": "^7.0.59",
    "bullmq": "^5.65.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.25.12",
    "standardwebhooks": "^1.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "imports": {
    "#*": "./src/*.ts"
  }
}
