# --- Database ---------------------------------------------------------------
# Neon pooled connection string. The app opens its own pg pool on top, so the
# pooled host is what you want here; DATABASE_URL_UNPOOLED stays for one-off
# scripts and migrations.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Optional. Keep this well under Neon's connection ceiling per container.
DATABASE_POOL_MAX=10

# --- Redis ------------------------------------------------------------------
# Sign-in codes and rate-limit counters. Upstash → Database → "Connect" →
# copy the ioredis / TLS URL, not the REST url+token pair: we hold a persistent
# connection rather than speaking HTTP, and BullMQ will need the same endpoint.
# Upstash always uses TLS, so the scheme is rediss:// with two s's.
REDIS_URL=rediss://default:password@host.upstash.io:6379

# --- Auth -------------------------------------------------------------------
# Keys the HMAC that fingerprints sign-in codes and derives Redis keys, so a
# dump of Redis reveals neither live codes nor addresses. 32+ characters.
# Generate with: openssl rand -base64 48
# Rotating it invalidates every outstanding code, which is harmless.
AUTH_SECRET=

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain verified in Resend.
EMAIL_FROM=BehindTheStory <account@behindthestory.co>

# --- AI ---------------------------------------------------------------------
# Model ids are resolved through the AI gateway today; see the migration note
# in the backend plan before deploying off Vercel.
AI_MODEL=anthropic/claude-opus-5
AI_UTILITY_MODEL=anthropic/claude-sonnet-5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
