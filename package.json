{
  "name": "behindthestory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "db:generate": "pnpm --filter @behindthestory/db db:generate",
    "db:migrate": "pnpm --filter @behindthestory/db db:migrate",
    "db:reset": "pnpm --filter @behindthestory/db db:reset",
    "dev": "turbo dev",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:reset",
    "dev:up": "docker compose up -d --wait",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "railway": "^3.9.0",
    "turbo": "^2.10.9"
  }
}
