{
  "name": "@behindthestory/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//": "Just-in-Time package: entrypoints are TypeScript source and the consumer's bundler compiles them. No build step, so there is nothing to keep in sync.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./registry": "./src/registry.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "db:backfill-workspaces": "node scripts/backfill-workspaces.mjs",
    "db:baseline": "node scripts/baseline.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/reset.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  }
}
